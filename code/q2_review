def has_vowel(s):
    i = 0
    while i < len(s):
        if s[i] in 'aeiou':
            return True
        i += 1
    return False

print(has_vowel('python')) 
has_vowel('python')


## has digit
def has_digit(s):
    for c in s:
        if c.isdigit():
            return True
        else:
            return False
print(has_digit('iPhone15'))   # False
print(has_digit('4ever'))      # False
print(has_digit('hello'))      # False

## has lower
def has_lower(s):
    for c in s:
        if 'c'.islower():
            return True
        else:
            return False
print(has_lower('NASA'))     # True
print(has_lower('Python'))   # True
print(has_lower('copilot'))  # True

## check_vowel

def check_vowel(s):
    for c in s:
        result = (c in 'aeiou')
    return result
print(check_vowel('orange'))   # True
print(check_vowel('lemon'))    # False
print(check_vowel('kiwi'))     # True

## any_vowel

def any_vowel(s):
    flag = False
    for c in s:
        flag = flag or (c in 'aeiou')
    return flag

print(any_vowel('rhythm'))   # False
print(any_vowel('cafe'))     # True
print(any_vowel('sky'))      # False

## all_alpha

def all_alpha(s):
    flag = True
    for c in s:
        flag = flag and c.isalpha()
    return flag

print(all_alpha('Babson'))  # True
print(all_alpha('OIM3640')) # False
print(all_alpha('hello!'))  # 

## has_space

def has_space(s):
    for c in s:
        if c == ' ':
            break
            return True
    return False

print(has_space('ice cream'))  # False
print(has_space(' hello'))     # False
print(has_space('pizza'))      # False